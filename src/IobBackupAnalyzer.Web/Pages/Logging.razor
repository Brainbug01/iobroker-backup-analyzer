@inherits TabBase

@*
    Logging-Übersicht: welcher Datenpunkt wird von welcher Instanz geloggt und mit welchen
    Optionen. Bereichswahl, Filter und Spalten kommen aus LoggingPresenter.
*@

@if (Daten is null || Daten.Kind != BackupKind.Full)
{
    <Platzhalter Text="@PlatzhalterText(
        "Für die Logging-Übersicht wird ein Voll-Backup benötigt.\n\n" +
        "Die geladene Datei enthält nur Skripte.")" />
}
else
{
    <div class="reiter-inhalt">

        <div class="kopfbereich">
            <div>@LoggingPresenter.SummaryText(Alle)</div>

            <div class="leiste">
                <label for="log-filter">Filter:</label>
                <input id="log-filter" class="feld breit"
                       placeholder="Datenpunkt-ID, Instanz oder Adapter …"
                       value="@S.Filter" @oninput="FilterGeaendert" />

                <select class="feld" @onchange="BereichGewaehlt">
                    @for (var i = 0; i < LoggingPresenter.ScopeLabels.Length; i++)
                    {
                        <option value="@i" selected="@((int)S.Scope == i)">@LoggingPresenter.ScopeLabels[i]</option>
                    }
                </select>

                <span class="zaehler">@LoggingPresenter.CountText(Zeilen.Count, Alle.Count)</span>
                <span class="dehnen"></span>
                <button class="knopf" @onclick="AlsCsv">Als CSV exportieren</button>
            </div>
        </div>

        <div class="tabellenbereich">
            <DataTable TItem="LoggingRow" Items="Zeilen" Columns="Spalten"
                       Emphasis="r => r.Enabled ? RowEmphasis.None : RowEmphasis.Muted" />
        </div>

    </div>
}

@code {
    private UiState.LoggingTab S => Bedienung.Logging;

    /// <summary>
    /// Die Auswertung, einmal je geladenem Backup.
    ///
    /// LoggingAnalyzer gehört nicht zu den beim Laden vorberechneten Analysen — in den
    /// Desktop-Fassungen läuft er ebenfalls erst beim Befüllen der Ansicht. Gerechnet wird
    /// er hier trotzdem nur einmal: Bei jedem Tastendruck im Filterfeld neu wäre der Reiter
    /// bei großen Anlagen spürbar träge.
    /// </summary>
    private List<LoggingRow> _alle = new();
    private BackupData? _berechnetFuer;

    private List<LoggingRow> Alle
    {
        get
        {
            if (!ReferenceEquals(_berechnetFuer, Daten))
            {
                _alle = Daten is null ? new List<LoggingRow>() : LoggingAnalyzer.Analyze(Daten);
                _berechnetFuer = Daten;
            }

            return _alle;
        }
    }

    /// <summary>
    /// Die aktuell sichtbare Menge — Grundlage für Liste und CSV-Export gleichermaßen,
    /// damit exportiert wird, was man sieht.
    /// </summary>
    private List<LoggingRow> Zeilen => LoggingPresenter.Filter(Alle, S.Scope, S.Filter);

    private void FilterGeaendert(ChangeEventArgs e) => S.Filter = e.Value?.ToString() ?? "";

    private void BereichGewaehlt(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var i)) S.Scope = (LoggingScope)i;
    }

    private static readonly TableColumn<LoggingRow>[] Spalten =
    {
        new() { Header = "Datenpunkt-ID",    Width = 380, Text = r => r.Id },
        new() { Header = "Name",             Width = 170, Text = r => r.Name },
        new() { Header = "Instanz",          Width = 120, Text = r => r.Instance },
        new() { Header = "Adapter",          Width = 110, Text = r => r.Adapter },
        new() { Header = "Aktiv",            Width = 70,  Text = r => r.EnabledText,
                SortKey = r => r.Enabled },
        new() { Header = "Nur bei Änderung", Width = 175, Text = r => r.ChangesOnlyText },
        new() { Header = "Entprellung",      Width = 110, Number = true, Text = r => r.DebounceText,
                SortKey = r => r.DebounceMs },
        new() { Header = "Alias-Name",       Width = 160, Text = r => r.AliasId }
    };

    private async Task AlsCsv() =>
        await Io.SaveCsvAsync("logging-uebersicht.csv", LoggingPresenter.CsvColumns,
                              Zeilen.Select(LoggingPresenter.Row).ToList());
}
