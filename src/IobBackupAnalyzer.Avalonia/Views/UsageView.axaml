<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IobBackupAnalyzer.Avalonia.Views.UsageView">

  <UserControl.Styles>
    <!-- Hinweis über der Tabelle, gleiche Gestaltung wie bei den verwaisten Datenpunkten. -->
    <Style Selector="Border.warnung">
      <Setter Property="Background" Value="#FFF9DB" />
      <Setter Property="BorderBrush" Value="#E0CE8A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.warnung TextBlock">
      <Setter Property="Foreground" Value="#5A3C00" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="DataGridRow.gedaempft">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="DataGridRow.warnung TextBlock">
      <Setter Property="Foreground" Value="#D98A00" />
    </Style>
    <Style Selector="DataGridRow.problem TextBlock">
      <Setter Property="Foreground" Value="#D9534F" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="8" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
      <TextBlock Name="Summary" TextWrapping="Wrap" />

      <Border Classes="warnung">
        <TextBlock Name="Warning" />
      </Border>

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Sicht:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Name="ViewChoice" Grid.Column="1" Width="200" />

        <CheckBox Name="OnlyWithStates" Grid.Column="2" Margin="12,0,0,0"
                  Content="Nur Skripte mit Datenpunkten" IsChecked="True" />
        <ComboBox Name="StateFilter" Grid.Column="3" Width="260" Margin="12,0,0,0" />

        <TextBlock Grid.Column="4" Text="Filter:" VerticalAlignment="Center" Margin="14,0,8,0" />
        <TextBox Name="Filter" Grid.Column="5" Width="240" Watermark="Skript oder Datenpunkt …" />

        <TextBlock Name="Count" Grid.Column="6" VerticalAlignment="Center"
                   Margin="14,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis" />
        <Button Name="Csv" Grid.Column="7" Content="Als CSV exportieren" />
      </Grid>

      <!-- Farblegende in den echten Zeilenfarben, je Sicht neu gefüllt. -->
      <StackPanel Name="Legend" Orientation="Horizontal" Spacing="18" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid Name="Split" RowDefinitions="3*,Auto,2*">

        <!-- ============ oben: die gewählte Richtung ============ -->
        <Panel Grid.Row="0">
          <DataGrid Name="ScriptRows" IsReadOnly="True" GridLinesVisibility="All"
                    CanUserSortColumns="True" CanUserResizeColumns="True"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Skript"       Binding="{Binding DisplayPath}" Width="340" />
              <DataGridTextColumn Header="Typ"          Binding="{Binding EngineText}"  Width="130" />
              <DataGridTextColumn Header="Status"       Binding="{Binding StatusText}"  Width="120" />
              <DataGridTextColumn Header="Datenpunkte"  Binding="{Binding StateCount}"  Width="125" />
              <DataGridTextColumn Header="liest"        Binding="{Binding ReadCount}"   Width="80" />
              <DataGridTextColumn Header="schreibt"     Binding="{Binding WriteCount}"  Width="100" />
            </DataGrid.Columns>
          </DataGrid>

          <DataGrid Name="StateRows" IsReadOnly="True" GridLinesVisibility="All"
                    CanUserSortColumns="True" CanUserResizeColumns="True"
                    AutoGenerateColumns="False" IsVisible="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Datenpunkt-ID" Binding="{Binding Id}"           Width="360" />
              <DataGridTextColumn Header="Name"          Binding="{Binding Name}"         Width="180" />
              <DataGridTextColumn Header="Art"           Binding="{Binding KindText}"     Width="130" />
              <DataGridTextColumn Header="Skripte"       Binding="{Binding ScriptCount}"  Width="90" />
              <DataGridTextColumn Header="Adapter"       Binding="{Binding AdapterCount}" Width="90" />
              <DataGridTextColumn Header="liest"         Binding="{Binding Readers}"      Width="80" />
              <DataGridTextColumn Header="schreibt"      Binding="{Binding Writers}"      Width="100" />
              <DataGridTextColumn Header="Zuletzt geändert"
                                  Binding="{Binding LastChangeText}" Width="215" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- Sicht „Verweise ins Leere": IDs aus Skripten ohne zugehöriges Objekt.
               Keine Gegenseite zum Anklicken — der Detailbereich bleibt in dieser Sicht leer. -->
          <DataGrid Name="DeadRefRows" IsReadOnly="True" GridLinesVisibility="All"
                    CanUserSortColumns="True" CanUserResizeColumns="True"
                    AutoGenerateColumns="False" IsVisible="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Skript"        Binding="{Binding ScriptName}"  Width="260" />
              <DataGridTextColumn Header="Status"        Binding="{Binding StatusText}"  Width="120" />
              <DataGridTextColumn Header="Datenpunkt-ID" Binding="{Binding StateId}"     Width="400" />
              <DataGridTextColumn Header="Befund"        Binding="{Binding VerdachtText}" Width="280" />
            </DataGrid.Columns>
          </DataGrid>
        </Panel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="Transparent" />

        <!-- ============ unten: die Gegenseite des gewählten Eintrags ============ -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,4,0,0">
          <TextBlock Name="DetailHeader" Grid.Row="0" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />

          <Panel Grid.Row="1">
            <DataGrid Name="ScriptDetail" IsReadOnly="True" GridLinesVisibility="All"
                      CanUserSortColumns="True" CanUserResizeColumns="True"
                      AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Datenpunkt-ID" Binding="{Binding StateId}"    Width="380" />
                <DataGridTextColumn Header="Name"          Binding="{Binding StateName}"  Width="180" />
                <DataGridTextColumn Header="Zugriff"       Binding="{Binding AccessText}" Width="130" />
                <DataGridTextColumn Header="Fundstelle"    Binding="{Binding HintText}"   Width="240" />
              </DataGrid.Columns>
            </DataGrid>

            <DataGrid Name="StateDetail" IsReadOnly="True" GridLinesVisibility="All"
                      CanUserSortColumns="True" CanUserResizeColumns="True"
                      AutoGenerateColumns="False" IsVisible="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Art"        Binding="{Binding SourceText}" Width="90" />
                <DataGridTextColumn Header="Verwender"  Binding="{Binding SourceName}" Width="340" />
                <DataGridTextColumn Header="Zugriff"    Binding="{Binding AccessText}" Width="130" />
                <DataGridTextColumn Header="Fundstelle" Binding="{Binding HintText}"   Width="260" />
                <DataGridTextColumn Header="Status"     Binding="{Binding StatusText}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </Panel>
        </Grid>
      </Grid>

      <TextBlock Name="PlaceholderText" TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                 Text="Kein Backup geladen." />
    </Grid>

  </Grid>
</UserControl>
