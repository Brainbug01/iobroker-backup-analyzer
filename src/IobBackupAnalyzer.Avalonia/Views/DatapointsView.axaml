<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IobBackupAnalyzer.Avalonia.Views.DatapointsView">

  <Grid Margin="8" RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Suche:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Name="Filter" Grid.Column="1" Width="340"
               Watermark="Datenpunkt-ID oder Name …" />
      <TextBlock Name="Count" Grid.Column="2" VerticalAlignment="Center"
                 Margin="14,0,0,0" Opacity="0.75" />
      <Button Name="Csv" Grid.Column="3" Content="Als CSV exportieren" />
    </Grid>

    <Grid Grid.Row="1">
      <DataGrid Name="Rows" IsReadOnly="True" GridLinesVisibility="All"
                CanUserSortColumns="True" CanUserResizeColumns="True"
                SelectionMode="Single" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Datenpunkt-ID"   Binding="{Binding Id}"             Width="420" />
          <DataGridTextColumn Header="Name"            Binding="{Binding Name}"           Width="200" />
          <DataGridTextColumn Header="Typ"             Binding="{Binding TypeAndUnit}"    Width="130" />
          <DataGridTextColumn Header="Rolle"           Binding="{Binding Role}"           Width="170" />
          <DataGridTextColumn Header="Zuletzt geändert" Binding="{Binding LastChangeText}" Width="215" />
          <DataGridTextColumn Header="Letzter Wert"    Binding="{Binding ValText}"        Width="300" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Name="PlaceholderText" TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                 Text="Kein Backup geladen." />
    </Grid>

    <!-- Der eigentliche Zweck des Tabs: der vollständige Wert zum Herauskopieren. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
      <TextBlock Name="Definition" Grid.Row="0" TextWrapping="Wrap" />
      <TextBlock Name="ValueInfo"  Grid.Row="1" TextWrapping="Wrap" Opacity="0.75"
                 Margin="0,2,0,0" />
      <Button Name="Copy" Grid.Row="2" Content="Wert kopieren" Margin="0,6,0,4"
              HorizontalAlignment="Left" IsEnabled="False" />
      <TextBox Name="Value" Grid.Row="3" Height="180" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, monospace" />
    </Grid>

  </Grid>
</UserControl>
