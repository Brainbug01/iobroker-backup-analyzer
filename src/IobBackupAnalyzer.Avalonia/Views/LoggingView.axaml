<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IobBackupAnalyzer.Avalonia.Views.LoggingView">

  <Grid Margin="8" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
      <TextBlock Name="Summary" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Name="Filter" Grid.Column="1" Width="280"
                 Watermark="Datenpunkt-ID, Instanz oder Adapter …" />
        <ComboBox Name="Scope" Grid.Column="2" Width="230" Margin="10,0,0,0" />
        <TextBlock Name="Count" Grid.Column="3" VerticalAlignment="Center"
                   Margin="14,0,0,0" Opacity="0.75" />
        <Button Name="Csv" Grid.Column="5" Content="Als CSV exportieren" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1">
      <DataGrid Name="Rows" IsReadOnly="True" GridLinesVisibility="All"
                CanUserSortColumns="True" CanUserResizeColumns="True"
                AutoGenerateColumns="False">
        <DataGrid.Styles>
          <!-- Abgeschaltetes Logging gedämpft: das ist der eigentliche Aufräumfall. -->
          <Style Selector="DataGridRow.deaktiviert">
            <Setter Property="Opacity" Value="0.55" />
          </Style>
          <Style Selector="DataGridCell.zahl TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Datenpunkt-ID"    Binding="{Binding Id}"
                              Width="380" />
          <DataGridTextColumn Header="Name"             Binding="{Binding Name}"     Width="170" />
          <DataGridTextColumn Header="Instanz"          Binding="{Binding Instance}" Width="120" />
          <DataGridTextColumn Header="Adapter"          Binding="{Binding Adapter}"  Width="110" />
          <DataGridTextColumn Header="Aktiv"            Binding="{Binding EnabledText}"
                              SortMemberPath="Enabled" Width="70" />
          <DataGridTextColumn Header="Nur bei Änderung" Binding="{Binding ChangesOnlyText}" Width="175" />
          <DataGridTextColumn Header="Entprellung"      Binding="{Binding DebounceText}"
                              SortMemberPath="DebounceMs" Width="110" CellStyleClasses="zahl" />
          <DataGridTextColumn Header="Alias-Name"       Binding="{Binding AliasId}"  Width="160" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Name="PlaceholderText" TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                 Text="Kein Backup geladen." />
    </Grid>

  </Grid>
</UserControl>
