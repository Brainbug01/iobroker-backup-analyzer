<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IobBackupAnalyzer.Avalonia.Views.AliasView">

  <Grid Margin="8" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
      <TextBlock Name="Summary" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Name="Filter" Grid.Column="1" Width="280" Watermark="Alias-ID oder Ziel …" />
        <ComboBox Name="Scope" Grid.Column="2" Width="260" Margin="10,0,0,0" />
        <TextBlock Name="Count" Grid.Column="3" VerticalAlignment="Center"
                   Margin="14,0,0,0" Opacity="0.75" />
        <Button Name="Csv" Grid.Column="5" Content="Als CSV exportieren" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1">
      <!-- Liste oben, Details unten - mit verschiebbarem Trenner wie in der Windows-App. -->
      <Grid Name="Split" RowDefinitions="3*,Auto,2*">

        <DataGrid Name="Rows" Grid.Row="0" IsReadOnly="True" GridLinesVisibility="All"
                  CanUserSortColumns="True" CanUserResizeColumns="True"
                  AutoGenerateColumns="False">
          <DataGrid.Styles>
            <!-- Alias ohne vorhandenes Ziel: der Fehlerfall, den man sucht. -->
            <Style Selector="DataGridRow.kaputt TextBlock">
              <Setter Property="Foreground" Value="#D9534F" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Alias-ID"  Binding="{Binding Id}"   Width="300" />
            <DataGridTextColumn Header="Name"      Binding="{Binding Name}" Width="150" />
            <DataGridTextColumn Header="Lese-Ziel" Binding="{Binding ReadTarget}" Width="300" />
            <DataGridTextColumn Header="Ziel vorhanden" Binding="{Binding ReadExistsText}" Width="150" />
            <DataGridTextColumn Header="Schreib-Ziel (abweichend)"
                                Binding="{Binding WriteTargetText}" Width="240" />
            <DataGridTextColumn Header="Schreib-Ziel vorhanden"
                                Binding="{Binding WriteExistsText}" Width="150" />
            <DataGridTextColumn Header="Konverter" Binding="{Binding ConverterText}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="Transparent" />

        <!-- ============ Detailbereich zur ausgewählten Zeile ============ -->
        <ScrollViewer Grid.Row="2">
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock Name="DetailHeader" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Konverter Lesen:"
                         Margin="0,8,8,0" VerticalAlignment="Top" />
              <TextBox Name="ConvRead" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                       FontFamily="Consolas,Menlo,monospace" Margin="0,3,0,3"
                       AcceptsReturn="True" MaxHeight="70" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Konverter Schreiben:"
                         Margin="0,8,8,0" VerticalAlignment="Top" />
              <TextBox Name="ConvWrite" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                       FontFamily="Consolas,Menlo,monospace" Margin="0,3,0,3"
                       AcceptsReturn="True" MaxHeight="70" />

              <Button Name="Generate" Grid.Row="2" Grid.Column="1"
                      Content="Konverter-Vorschlag erzeugen" Margin="0,6,0,6"
                      HorizontalAlignment="Left" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Vorschlag Lesen:"
                         Margin="0,8,8,0" VerticalAlignment="Top" />
              <TextBox Name="GenRead" Grid.Row="3" Grid.Column="1" IsReadOnly="True"
                       FontFamily="Consolas,Menlo,monospace" Margin="0,3,0,3"
                       AcceptsReturn="True" MaxHeight="70" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Vorschlag Schreiben:"
                         Margin="0,8,8,0" VerticalAlignment="Top" />
              <TextBox Name="GenWrite" Grid.Row="4" Grid.Column="1" IsReadOnly="True"
                       FontFamily="Consolas,Menlo,monospace" Margin="0,3,0,3"
                       AcceptsReturn="True" MaxHeight="70" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Hinweis:" Margin="0,8,8,0"
                         VerticalAlignment="Top" Opacity="0.75" />
              <TextBlock Name="GenNote" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"
                         Margin="0,8,0,0" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <TextBlock Name="PlaceholderText" TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                 Text="Kein Backup geladen." />
    </Grid>

  </Grid>
</UserControl>
