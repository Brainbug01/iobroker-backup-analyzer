<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IobBackupAnalyzer.Avalonia.Views.ScriptsView">

  <Grid Margin="8" RowDefinitions="Auto,Auto,*">

    <!-- ================= Filterleiste ================= -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="Suche:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Name="Search" Grid.Column="1" Width="300" Watermark="Suchbegriff …" />
      <ComboBox Name="SearchMode" Grid.Column="2" Width="170" Margin="8,0,0,0" />
      <TextBlock Grid.Column="3" Text="Typ:" VerticalAlignment="Center" Margin="14,0,8,0" />
      <ComboBox Name="TypeFilter" Grid.Column="4" Width="150" />
      <CheckBox Name="HideDisabled" Grid.Column="5" Content="Deaktivierte ausblenden"
                Margin="14,0,0,0" VerticalAlignment="Center" />
      <CheckBox Name="OnlyWithHints" Grid.Column="6"
                Margin="14,0,0,0" VerticalAlignment="Center" />
    </Grid>

    <!-- ================= Zählzeile und Aktionen ================= -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Name="Count" Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" />
        <Button Name="Clipboard"      Grid.Column="1" Content="In Zwischenablage"      Margin="0,0,8,0" />
        <Button Name="ExportSelected" Grid.Column="2" Content="Ausgewählte exportieren" Margin="0,0,8,0" />
        <Button Name="ExportAll"      Grid.Column="3" Content="Alle exportieren"        Margin="0,0,8,0" />
        <Button Name="ListCsv"        Grid.Column="4" Content="Liste als CSV" />
      </Grid>

      <!-- Aus = je Skript genau eine Datei, so wie sie auch in ioBroker liegt. -->
      <CheckBox Name="WithGeneratedJs" Grid.Row="1" HorizontalAlignment="Right"
                Margin="0,4,0,0" IsChecked="False" />
    </Grid>

    <!-- ================= Liste und Vorschau ================= -->
    <Grid Grid.Row="2">
      <Grid Name="Split" RowDefinitions="2*,Auto,Auto,Auto,3*">

        <DataGrid Name="List" Grid.Row="0" IsReadOnly="True" GridLinesVisibility="All"
                  CanUserSortColumns="True" CanUserResizeColumns="True"
                  SelectionMode="Extended" AutoGenerateColumns="False">
          <DataGrid.Styles>
            <Style Selector="DataGridRow.gedaempft">
              <Setter Property="Opacity" Value="0.55" />
            </Style>
            <!-- Auffälligkeit im Blockly-Aufbau, siehe Spalte „Hinweise". -->
            <Style Selector="DataGridRow.warnung TextBlock">
              <Setter Property="Foreground" Value="#C77700" />
            </Style>
            <!-- Defektes Blockly: das XML ließ sich nicht dekodieren. -->
            <Style Selector="DataGridRow.problem TextBlock">
              <Setter Property="Foreground" Value="#D9534F" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name"          Binding="{Binding Name}"       Width="220" />
            <DataGridTextColumn Header="ioBroker-Pfad" Binding="{Binding Id}"         Width="400" />
            <DataGridTextColumn Header="Typ"           Binding="{Binding EngineText}" Width="140" />
            <DataGridTextColumn Header="Status"        Binding="{Binding StatusText}" Width="120" />
            <DataGridTextColumn Header="Hinweise"      Binding="{Binding HintsText}"  Width="240" />
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="Transparent" />

        <!-- Befunde zum gewählten Skript; nur sichtbar, wenn es welche gibt. Bewusst
             über der Vorschau statt in ihr — die zeigt unverändert den Quelltext. -->
        <Border Name="HintsBox" Grid.Row="2" IsVisible="False"
                Background="#FFF8E1" BorderBrush="#E0C97A" BorderThickness="1"
                CornerRadius="3" Padding="8,6" Margin="0,0,0,4" MaxHeight="140">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Name="Hints" TextWrapping="Wrap" Foreground="#5A3C00" />
          </ScrollViewer>
        </Border>

        <!--
          Die Leiste über der Vorschau. Sie bleibt immer stehen, weil der Kopierknopf
          immer gebraucht wird; die beiden Umschalter daneben gibt es nur bei Blockly.

          Den Knopf gibt es oben in der Aktionsleiste zwar schon — dort sucht ihn aber
          niemand, der gerade einen Quelltext liest. Seine Aufschrift kommt aus dem
          Presenter und nennt, was er mitnimmt: bei Blockly je nach Umschaltung das XML
          oder den erzeugten Quelltext.
        -->
        <Grid Name="ViewSwitch" Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,4">
          <StackPanel Name="ViewChoice" Grid.Column="0" Orientation="Horizontal"
                      Spacing="16" IsVisible="False">
            <RadioButton Name="ShowJs"  GroupName="Ansicht" Content="Generiertes JavaScript" IsChecked="True" />
            <RadioButton Name="ShowXml" GroupName="Ansicht" Content="Blockly-XML" />
          </StackPanel>

          <Button Name="CopyPreview" Grid.Column="2" IsEnabled="False" />
        </Grid>

        <TextBox Name="Preview" Grid.Row="4" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,monospace"
                 VerticalContentAlignment="Top" />
      </Grid>

      <TextBlock Name="PlaceholderText" TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                 Text="Kein Backup geladen.&#10;&#10;Bitte oben eine Datei öffnen oder hineinziehen." />
    </Grid>

  </Grid>
</UserControl>
