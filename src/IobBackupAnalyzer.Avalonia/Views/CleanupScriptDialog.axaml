<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IobBackupAnalyzer.Avalonia.Views.CleanupScriptDialog"
        Title="Aufräum-Skript für Waisen-States erzeugen"
        Width="1000" Height="640" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="10">

    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Namensraum anhaken, dessen übrig gebliebene Werte weg sollen — oder ihn aufklappen und einzelne Werte auswählen. Rechts entsteht daraus ein Shell-Skript. Speichern, auf den ioBroker-Host kopieren, dort „bash &lt;Datei&gt;“ aufrufen — das Skript fragt beim Start, ob es löschen oder nur testen soll." />

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,10,0,0">
      <Button Name="All"  Grid.Column="0" Content="Alle auswählen" Margin="0,0,8,0" />
      <Button Name="None" Grid.Column="1" Content="Keine" />
      <Button Name="Save" Grid.Column="3" Content="Skript speichern…" Margin="0,0,8,0" />
      <Button Name="Copy" Grid.Column="4" Content="Skript kopieren" Margin="0,0,8,0" />
      <!-- Nicht "Close" nennen: Avalonia erzeugt aus Name ein Feld, das Window.Close() verdecken würde. -->
      <Button Name="CloseButton" Grid.Column="5" Content="Schließen" Width="110" />
    </Grid>

    <Grid ColumnDefinitions="380,8,*">

      <DockPanel Grid.Column="0">

        <TextBox Name="Search" DockPanel.Dock="Top" Margin="0,0,0,6"
                 Watermark="Suchen — Teil einer ID oder eines Adapternamens" />

        <!-- Zuerst gedockt heißt unterste Zeile: der Warnhinweis steht unter dem Zähler. -->
        <TextBlock Name="Hidden" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                   Margin="2,4,0,0" Foreground="#A05000" IsVisible="False" />
        <TextBlock Name="Count" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="2,6,0,0" />

        <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3">
          <TreeView Name="Tree">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <!-- IsThreeState bleibt aus: Der Zustand „teilweise" wird gezeigt (IsChecked = null),
                     aber ein Klick soll ihn nicht herstellen können - er wählt die Gruppe ganz aus. -->
                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding Label}" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

      </DockPanel>

      <TextBox Grid.Column="2" Name="Script" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas,Menlo,monospace"
               VerticalContentAlignment="Top" />
    </Grid>

  </DockPanel>
</Window>
