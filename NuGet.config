<?xml version="1.0" encoding="utf-8"?>
<!--
  Projektlokale NuGet-Quelle.

  Das Tool selbst nutzt bewusst keine Fremdbibliotheken. Diese Quelle wird
  ausschliesslich fuer die .NET-Runtime-Pakete von Microsoft benoetigt, die ein
  self-contained Single-File-Publish voraussetzt (Microsoft.NETCore.App.Runtime.win-x64
  und Microsoft.WindowsDesktop.App.Runtime.win-x64).

  Bewusst hier im Projekt und nicht in der globalen NuGet.Config des Systems, damit
  andere Projekte unveraendert bleiben.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
